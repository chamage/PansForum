# Copy this file to .env and customize for your environment.
# In production, set DJANGO_DEBUG=false and generate a strong DJANGO_SECRET_KEY:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

SITE_NAME="PANS Agora"
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://forum.example.edu
DJANGO_ADMIN_URL=admin/
DJANGO_SECURE_SSL_REDIRECT=true

# Database (defaults to SQLite if unset; use PostgreSQL in production)
# DATABASE_URL=postgres://user:password@localhost:5432/pans_agora

# Optional Redis cache (uses database cache table if unset)
# REDIS_URL=redis://localhost:6379/1
